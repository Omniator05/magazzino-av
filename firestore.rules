rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function myProfile() {
      return get(/databases/$(database)/documents/profiles/$(request.auth.uid));
    }
    function myTeamId() {
      return myProfile().data.teamId;
    }
    // Membro approvato e attivo della squadra indicata — condizione di
    // accesso base per leggere/scrivere qualunque dato di quella squadra.
    function isApprovedMember(teamId) {
      // .get(key, default) invece di .data.approved: sui profili creati prima
      // dell'introduzione del flusso di approvazione il campo non esiste, e
      // leggere un campo assente con .data.x genera un errore di valutazione
      // (non null) che farebbe fallire la regola per tutti gli account storici.
      return request.auth != null
        && myProfile().data.teamId == teamId
        && myProfile().data.get('approved', true) != false
        && myProfile().data.get('active', true) != false;
    }
    function isTeamAdmin(teamId) {
      return isApprovedMember(teamId) && myProfile().data.role == 'admin';
    }
    // Super admin ("amministratore ghost"): flag impostato SOLO manualmente
    // da console/script admin — mai dall'app (vedi guardie su create/update
    // di profiles). In modalità ghost (lato client) opera sui dati di
    // un'altra squadra per assisterla/correggerne le impostazioni: le regole
    // sotto gli danno pieno accesso equivalente a un admin di QUALSIASI
    // squadra — non solo lettura — perché "entra" per risolvere problemi,
    // non solo osservare.
    function isSuperAdmin() {
      return request.auth != null && myProfile().data.get('superAdmin', false) == true;
    }
    // Abbonamento valido: esente (squadre "grandfathered" o la nostra),
    // attivo, oppure ancora in prova gratuita e non scaduta. Le squadre create
    // prima di questa feature vengono marcate 'exempt' una tantum (script di
    // migrazione) — senza billingStatus impostato il default 'exempt' NON si
    // applica qui apposta: una squadra nuova deve sempre avere trialing+data
    // esplicite (impostate da Signup.jsx alla creazione), quindi un campo
    // assente indica un bug di scrittura, non un caso da lasciar passare.
    function hasValidBilling(teamId) {
      let team = get(/databases/$(database)/documents/teams/$(teamId)).data;
      let status = team.get('billingStatus', 'trialing');
      return status == 'exempt' || status == 'active'
        || (status == 'trialing' && team.get('trialEndsAt', request.time) > request.time);
    }
    // Wrapper usati ovunque prima si usava isApprovedMember/isTeamAdmin per
    // decidere l'accesso a UNA squadra specifica: il super admin li supera
    // sempre, qualunque sia teamId — anche a scadenza abbonamento, per poter
    // assistere/sbloccare un cliente.
    function canAccessTeam(teamId) {
      return (isApprovedMember(teamId) && hasValidBilling(teamId)) || isSuperAdmin();
    }
    function canAdminTeam(teamId) {
      return (isTeamAdmin(teamId) && hasValidBilling(teamId)) || isSuperAdmin();
    }

    match /profiles/{uid} {
      // Signup: il profilo non esiste ancora, non può dipendere da myProfile().
      // Nessuno può nascere già superAdmin. Un admin può anche creare il
      // profilo di un NUOVO worker/utente della propria squadra (AdminUsers.jsx,
      // Welcome.jsx): da quando la creazione account usa un'app Firebase
      // secondaria per non switchare la sessione admin (vedi src/firebase.js),
      // request.auth.uid resta quello dell'admin — non più uguale a `uid` come
      // capitava prima "per sbaglio" quando la sessione veniva davvero switchata.
      allow create: if request.auth != null
        && request.resource.data.get('superAdmin', false) != true
        && (request.auth.uid == uid || canAdminTeam(request.resource.data.teamId));
      // Il proprio profilo è sempre leggibile (serve anche prima dell'approvazione,
      // per la schermata "in attesa"); un membro approvato (o il super admin)
      // legge anche i profili della squadra (es. AdminUsers, assegnazione worker).
      allow read: if request.auth != null
        && (request.auth.uid == uid || canAccessTeam(resource.data.teamId));
      // Il flag superAdmin è immutabile dall'app: qualunque update deve
      // lasciarlo esattamente com'era (assente compreso).
      allow update: if request.auth != null
        && (canAdminTeam(resource.data.teamId) || request.auth.uid == uid)
        && request.resource.data.get('superAdmin', false) == resource.data.get('superAdmin', false);
      allow delete: if canAdminTeam(resource.data.teamId);
    }

    match /teams/{teamId} {
      // Lettura pubblica (anche senza login): serve per la ricerca per nome
      // azienda e il controllo duplicati in Signup, che avvengono PRIMA che
      // l'utente crei il proprio account Firebase Auth. Espone solo nome
      // squadra e logo, non è un dato sensibile.
      allow read: if true;
      allow create: if request.auth != null;
      allow update: if canAdminTeam(teamId);
      // Eliminazione azienda: SOLO il super admin, mai un admin della propria
      // squadra (troppo distruttivo per essere self-service dai clienti).
      allow delete: if isSuperAdmin();
    }

    // Pattern comune per tutte le collection dati applicative: items, events,
    // tasks, templates, unavailability, brasserieWeeks, brasserieArtists,
    // googleCalendarEvents, eventOrganizerContent.
    match /{collection}/{docId} {
      // get() su un documento che non esiste ancora (es. eventOrganizerContent
      // prima che un organizzatore carichi contenuti, brasserieWeeks per una
      // settimana mai salvata) ha resource == null: leggere resource.data in
      // quel caso genera un errore di valutazione, non un false — va gestito
      // esplicitamente, altrimenti anche i listener su documenti legittimamente
      // assenti falliscono con permission-denied invece di restituire "non esiste".
      allow get: if collection != 'profiles' && collection != 'teams'
        && (resource == null || canAccessTeam(resource.data.teamId));
      allow list, update, delete: if collection != 'profiles' && collection != 'teams'
        && canAccessTeam(resource.data.teamId);
      allow create: if collection != 'profiles' && collection != 'teams'
        && canAccessTeam(request.resource.data.teamId);
    }
  }
}
